{
  "name": "dsh-parallel-sessions",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "description": "Detect parallel DeepSeek Harness sessions, relay attributed cross-session messages, and pause/resume sessions whose task phases conflict.",
  "license": "MIT",
  "author": "CatLollipop",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatLollipop/dsh-parallel-sessions.git"
  },
  "homepage": "https://github.com/CatLollipop/dsh-parallel-sessions#readme",
  "bugs": {
    "url": "https://github.com/CatLollipop/dsh-parallel-sessions/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cross-session",
    "multi-agent",
    "orchestration",
    "pause-resume"
  ]
}
